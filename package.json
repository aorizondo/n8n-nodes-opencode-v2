{
	"name": "n8n-nodes-opencode-v2",
	"version": "0.1.0",
	"description": "n8n node for OpenCode V2: chat with persistent sessions, switch agents within a session, run agent tasks with tools",
	"license": "MIT",
	"homepage": "https://github.com/aorizondo/n8n-nodes-opencode-v2#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"opencode",
		"ai",
		"agent",
		"chatbot"
	],
	"author": {
		"name": "Antonio Orizondo Leyva",
		"email": "aorizondoleyva@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aorizondo/n8n-nodes-opencode-v2.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/*.test.mjs\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenCodeV2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenCode/OpenCode.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.6",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
